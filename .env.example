# SellerBoost AI — Environment Configuration
# Copy this file to .env and fill in your values

# AI Provider: "backboard" | "ollama" | "mock"
AI_PROVIDER=backboard

# Backboard API Key (get from https://app.backboard.io/dashboard)
BACKBOARD_API_KEY=

# Backboard configuration
BACKBOARD_BASE_URL=https://app.backboard.io/api
BACKBOARD_DEFAULT_PROVIDER=openrouter
BACKBOARD_DEFAULT_MODEL=meta-llama/llama-3.1-8b-instruct
BACKBOARD_MULTILINGUAL_MODEL=qwen/qwen-2.5-72b-instruct

# Ollama local inference (fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.1:8b

# Credit tracking
INITIAL_PROMO_CREDIT_USD=5.0

# Server
HOST=127.0.0.1
PORT=8000
DEBUG=false
